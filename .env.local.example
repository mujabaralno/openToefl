# =============================================================================
# PTESOL — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in your values:
#   cp .env.local.example .env.local
# =============================================================================

# ---------------------------
# Supabase (Public — safe for client-side)
# ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# ---------------------------
# Supabase (Secret — server-only, NEVER expose to client)
# ---------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ---------------------------
# Groq AI (Post-MVP — server-only)
# ---------------------------
GROQ_API_KEY=gsk_...your-groq-api-key

# ---------------------------
# Resend Email (Post-MVP — server-only)
# ---------------------------
# RESEND_API_KEY=re_...your-resend-api-key
# RESEND_FROM=PTESOL <onboarding@resend.dev>

# ---------------------------
# Cron (Post-MVP — server-only). Protects /api/cron/* endpoints.
# Vercel Cron auto-sends `Authorization: Bearer ${CRON_SECRET}` when set.
# ---------------------------
# CRON_SECRET=your-long-random-secret
